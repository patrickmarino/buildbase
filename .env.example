# ── Docker / database ───────────────────────────────────────
# Used by the API (sqlx) and by docker-compose (infra/docker-compose.yml).
# COMPOSE_PROJECT_NAME → docker network, volume, and container prefix
# (containers core-postgres / core-mailpit). bootstrap.sh sets it from the project slug.
COMPOSE_PROJECT_NAME=core
POSTGRES_USER=core
POSTGRES_PASSWORD=core
POSTGRES_DB=core
# Host port for the dockerized Postgres (5440 avoids clashing with other local DBs).
PG_HOST_PORT=5440
DATABASE_URL=postgres://core:core@localhost:5440/core?sslmode=disable

# ── API server ──────────────────────────────────────────────
API_BIND_ADDR=127.0.0.1:8080
# Origin of the SPA (for CORS with credentials).
WEB_ORIGIN=http://localhost:5173
# Session cookie TTL in seconds (default 7 days).
SESSION_TTL_SECS=604800
# Set Secure flag on the session cookie (true in prod over HTTPS).
COOKIE_SECURE=false

# ── Email (SMTP → Mailpit in dev) ───────────────────────────
# Points at the dockerized Mailpit (infra/docker-compose.yml). Web UI for
# catching sent mail: http://localhost:8026. Leave SMTP_HOST empty to disable
# sending (the API logs "would send" instead).
SMTP_HOST=localhost
SMTP_PORT=1026
EMAIL_FROM=no-reply@madespace.co
EMAIL_FROM_NAME="MadeSpace Studio"
# Host ports for the Mailpit container (defaults avoid clashing with other local Mailpit).
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026

# ── First-boot seed (idempotent: only runs when no users exist) ──
SEED_OWNER=true
SEED_OWNER_EMAIL=elena@madespace.co
SEED_OWNER_PASSWORD=changeme-dev-only
SEED_ORG_NAME="MadeSpace Studio"
SEED_ORG_DOMAIN=madespace.co

# ── Frontend ────────────────────────────────────────────────
# Base URL the SPA calls. Empty = same-origin via Vite proxy in dev.
VITE_API_BASE=http://localhost:8080
